{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KimiSwitch",
  "version": "0.2.1",
  "identifier": "com.kimiswitch.desktop",
  "build": {
    "beforeDevCommand": "pnpm run sidecar && pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run sidecar && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KimiSwitch",
        "width": 1000,
        "height": 650,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:15722; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/kimi-switch-proxy"],
    "resources": ["../THIRD_PARTY_NOTICES.md"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "kyuiazusa",
    "copyright": "Copyright © 2026 kyuiazusa",
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 205
        }
      }
    },
    "shortDescription": "Kimi Code account switcher and local proxy",
    "longDescription": "Manage authorized Kimi Code API keys, switch accounts, rotate requests, and observe local token usage."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNzQ1NzNFODQ2QTgzMEIKUldRTGcycUVQbGQwRys1aGhES1BWUHVyL0xIcUh5cmp5cEVaRXAyV0hLR0txT3krMFNrM2Z4VTAK",
      "endpoints": [
        "https://github.com/kyui-azusa/kimi-switch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
